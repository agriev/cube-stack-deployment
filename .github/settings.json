{
  "_comment": "probot/settings format. Apply via the Settings App or by porting these to gh api repos/.../branches/.../protection.",
  "repository": {
    "name": "cube-stack-deployment",
    "description": "Helm charts for Cube.js semantic layer on Kubernetes — vanilla and HA",
    "default_branch": "main",
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": true,
    "delete_branch_on_merge": true,
    "has_issues": true,
    "has_projects": false,
    "has_wiki": false
  },
  "branches": [
    {
      "name": "main",
      "protection": {
        "required_pull_request_reviews": {
          "required_approving_review_count": 1,
          "dismiss_stale_reviews": true,
          "require_code_owner_reviews": false
        },
        "required_status_checks": {
          "strict": true,
          "contexts": [
            "helm-lint (cube-stack)",
            "helm-lint (cube-stack-ha)",
            "chart-testing (cube-stack)",
            "chart-testing (cube-stack-ha)",
            "kubeconform (cube-stack)",
            "kubeconform (cube-stack-ha)"
          ]
        },
        "enforce_admins": false,
        "required_linear_history": true,
        "allow_force_pushes": false,
        "allow_deletions": false,
        "required_conversation_resolution": true
      }
    }
  ]
}
